#lang attalambda

; Milestone 4 foundations, end to end: exact negative fractions, exact
; division, whole powers, Unit acknowledgements, text/binary crossing,
; Option, and persistent Map. Every check prints one deterministic line.
(def show name passed =
  (stdout
   (string-append (if passed "ok " "FAIL ")
                  (string-append name "\n"))))

(show "negative-fraction" (eq (add -7/3 1/3) -2))
(show "exact-division" (eq (unwrap-ok (div 7 2)) 7/2))
(show "power" (eq (unwrap-ok (exp -3/2 5)) -243/32))
(show "negative-power" (eq (unwrap-ok (exp 2 -3)) 1/8))
(show "floor" (eq (floor -7/2) -4))
(show "unit-acknowledgement" (is-ok (stdout "")))
(show "bytes" (string-eq (bytes-to-string (string-to-bytes "λ")) "λ"))
(show "option"
      (option-case (map-lookup (map-set (make-map eq) 2/3 42) 2/3)
                   (lambda (value) (eq value 42))
                   FALSE))
(let base = (map-set (make-map eq) 1 10)
  (let updated = (map-remove base 1)
    (show "map-persistence"
          (and (is-some (map-lookup base 1))
               (is-none (map-lookup updated 1))))))
