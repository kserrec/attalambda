#lang attalambda

; Run this example in an empty scratch directory. It creates or replaces the
; relative file named below, then emits the bytes it reads back.
(def path = "attalambda-round-trip.txt")
(def contents = "AttaLambda file round trip.\n")

(let write-result = (write-file path (string-to-bytes contents))
  (if (is-ok write-result)
      (let read-result = (read-file path)
        (if (is-ok read-result)
            (stdout (bytes-to-string (unwrap-ok read-result)))
            read-result))
      write-result))
