 ;; the cursor advanced.
 (define char-widths (make-hasheqv))
 
+;; Source controls are data, never terminal commands. Share their display
+;; spelling with geometry, retaining the original character in the entry.
+(define display-columns #f)
+(define (native-char-width c)
+  (max 0 (or (hash-ref char-widths c #f) (terminal-char-width c))))
+(define (character-display-string c)
+  (define n (char->integer c))
+  (define spelling
+    (cond
+      [(< n 32) (string #\^ (integer->char (+ n 64)))]
+      [(= n 127) "^?"]
+      [(<= 128 n 159)
+       (string-append "\\x" (string-upcase (number->string n 16)))]
+      [else #f]))
+  (cond
+    [spelling
+     (if (and display-columns (< display-columns (string-length spelling)))
+         "?"
+         spelling)]
+    ;; An indivisible character wider than the whole screen cannot advance
+    ;; the layout loop. Only its display changes, never the source character.
+    [(and display-columns (< display-columns (native-char-width c))) "?"]
+    [else #f]))
+
