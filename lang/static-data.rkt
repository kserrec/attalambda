#lang racket/base

;; Private inert transport between compile-time source analysis and the runner.
;; Prefabs have the same identity across phases and executable embedding.
(require racket/list)
(provide analysis-request-key analysis-result-key analysis-request
         (struct-out source-location) (struct-out source-node)
         (struct-out source-binding) (struct-out source-view)
         validate-source-view)

(define analysis-request-key 'attalambda-static-request)
(define analysis-result-key 'attalambda-static-result)
(define analysis-request 'attalambda-static-v1)
(struct source-location (source line column position span) #:prefab)
(struct source-node (id kind location data children) #:prefab)
(struct source-binding (id name location value recursive? dependencies) #:prefab)
(struct source-view (bindings expressions registry forms) #:prefab)

(define (validate-source-view view expected-forms)
  (define (check condition reason)
    (unless condition (error 'static-source "invalid analysis metadata: ~a" reason)))
  (define (location? value)
    (and (source-location? value)
         (or (not (source-location-source value)) (string? (source-location-source value)))
         (andmap (lambda (n) (or (not n) (exact-nonnegative-integer? n)))
                 (list (source-location-line value) (source-location-column value)
                       (source-location-position value) (source-location-span value)))))
  (check (source-view? view) "missing or malformed view")
  (define bindings (source-view-bindings view))
  (define expressions (source-view-expressions view))
  (define registry (source-view-registry view))
  (define forms (source-view-forms view))
  (check (and (list? bindings) (andmap source-binding? bindings)
              (list? expressions) (list? registry) (list? forms)) "malformed collections")
  (check (= (length forms) expected-forms) "omitted source form")
  (define global-ids (map source-binding-id bindings))
  (check (and (andmap exact-nonnegative-integer? global-ids)
              (= (length global-ids) (length (remove-duplicates global-ids))))
         "duplicate declaration identity")
  (define binder-ids (make-hasheqv))
  (for ([id (in-list global-ids)]) (hash-set! binder-ids id #t))
  (define registered (make-hasheqv))
  (for ([entry (in-list registry)])
    (check (and (list? entry) (= (length entry) 3)
                (exact-nonnegative-integer? (car entry))
                (memq (cadr entry) '(literal reference application lambda let list cond))
                (location? (caddr entry))) "malformed source registry entry")
    (check (not (hash-has-key? registered (car entry))) "duplicate source ID")
    (hash-set! registered (car entry) entry))
  (define seen (make-hasheqv))
  (define visited (make-hasheq))
  (define (binder id)
    (check (and (exact-nonnegative-integer? id) (not (hash-has-key? binder-ids id)))
           "duplicate lexical binder")
    (hash-set! binder-ids id #t))
  (define (walk node bound)
    (check (source-node? node) "malformed node")
    (check (not (hash-has-key? visited node)) "shared or cyclic node")
    (hash-set! visited node #t)
    (define id (source-node-id node))
    (define kind (source-node-kind node))
    (define data (source-node-data node))
    (define children (source-node-children node))
    (check (and (location? (source-node-location node)) (list? children)) "malformed node fields")
    (when id
      (check (and (exact-nonnegative-integer? id) (hash-has-key? registered id)
                  (not (hash-has-key? seen id))) "missing or duplicate source ID")
      (check (equal? (source-node-location node) (caddr (hash-ref registered id)))
             "inconsistent source origin")
      (check (eq? (cadr (hash-ref registered id))
                  (case kind [(builtin reference) 'reference] [(group) data] [else kind]))
             "inconsistent source kind")
      (hash-set! seen id #t))
    (case kind
      [(literal)
       (check (and (null? children) (memq data '(Rat String Char))) "invalid literal node")]
      [(builtin)
       (check (and (null? children) (symbol? data)) "invalid builtin node")]
      [(reference)
       (check (and (null? children) (exact-nonnegative-integer? data)
                   (memv data bound)) "unresolved binding token")]
      [(lambda)
       (check (= (length children) 1) "invalid lambda arity")
       (binder data)
       (walk (car children) (cons data bound))]
      [(let)
       (check (= (length children) 2) "invalid let arity")
       (binder data)
       (walk (car children) bound)
       (walk (cadr children) (cons data bound))]
      [(application)
       (check (and (not data) (= (length children) 2)) "invalid application arity")
       (for ([child (in-list children)]) (walk child bound))]
      [(group)
       (check (and (memq data '(let list cond)) (= (length children) 1)) "invalid sugar group")
       (walk (car children) bound)]
      [else (check #f "unknown node kind")]))
  (for ([binding (in-list bindings)])
    (check (and (symbol? (source-binding-name binding))
                (location? (source-binding-location binding))
                (boolean? (source-binding-recursive? binding))
                (list? (source-binding-dependencies binding))
                (andmap (lambda (id) (memv id global-ids)) (source-binding-dependencies binding)))
           "invalid declaration")
    (walk (source-binding-value binding) global-ids))
  (for ([node (in-list expressions)]) (walk node global-ids))
  (check (= (hash-count seen) (hash-count registered)) "unaccounted source expression")
  (define expected
    (append (map (lambda (id) (list 'binding id)) global-ids)
            (map (lambda (node) (list 'expression (source-node-id node))) expressions)))
  (check (and (= (length forms) (length expected))
              (= (length forms) (length (remove-duplicates forms equal?)))
              (andmap (lambda (entry) (member entry expected equal?)) forms))
         "missing or duplicate top-level form")
  view)
